{
  "manifest_version": 3,
  "name": "German Word Lookup",
  "version": "0.1.0",
  "description": "Look up selected German words on Verbformen.",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["https://www.verbformen.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "German Word Lookup", "default_popup": "popup.html" },
  "icons": { "16": "icon.svg", "48": "icon.svg", "128": "icon.svg" }
}
